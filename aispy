local function spyLog(direction, remote, method, arguments)
    if not spyState.enabled or not remote then
        return
    end

    spyCounter += 1

    local entry = {
        id = spyCounter,
        direction = direction,
        remote = remote,
        method = method,
        arguments = arguments,
        time = timeStamp(),
    }

    local row = create("TextButton", {
