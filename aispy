local function refreshScripts()
    scriptCache = {}
    local seen = {}

    local function addScript(instance)
        if not instance or seen[instance] then
            return
        end

        if instance:IsA("LuaSourceContainer") then
            seen[instance] = true
            table.insert(scriptCache, instance)
        end
    end

    if API.getScripts then
        pcall(function()
            for _, instance in ipairs(API.getScripts()) do
                addScript(instance)
            end
        end)
    end

    if API.getLoadedModules then
        pcall(function()
            for _, instance in ipairs(API.getLoadedModules()) do
                addScript(instance)
            end
        end)
    end

    for _, instance in ipairs(game:GetDescendants()) do
        addScript(instance)
    end

    if API.getNilInstances then
        pcall(function()
            for _, instance in ipairs(API.getNilInstances()) do
                addScript(instance)
            end
        end)
    end

    table.sort(scriptCache, function(a, b)
        return getPath(a):lower() < getPath(b):lower()
    end)

    renderScriptRows()
end

