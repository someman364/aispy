    end
end

local function runRemote()
    local remote = selectedRemote
    if not remote or not remote.Parent then
        setStatus("Select a remote first.", COLORS.orange)
        return
    end

    local arguments, parseError = parseArguments(argumentsBox.Text)
    if not arguments then
        appendOutput("Argument error: " .. tostring(parseError), COLORS.red)
        setStatus("Could not parse arguments.", COLORS.red)
        return
    end

    local argumentCount = arguments.n

    if remote:IsA("RemoteFunction") then
        appendOutput(string.format("%s  INVOKE  %s", timeStamp(), getPath(remote)), COLORS.orange)
        setStatus("Invoking RemoteFunction...", COLORS.orange)

        task.spawn(function()
            local ok, result = pcall(remote.InvokeServer, remote, table.unpack(arguments, 1, argumentCount))
            if ok then
                appendOutput("Result: " .. formatValue(result), COLORS.green)
                setStatus("RemoteFunction returned.", COLORS.green)
            else
                appendOutput("Invoke error: " .. tostring(result), COLORS.red)
                setStatus("RemoteFunction failed.", COLORS.red)
            end
        end)
    else
        local ok, err = pcall(remote.FireServer, remote, table.unpack(arguments, 1, argumentCount))
        if ok then
            appendOutput(string.format("%s  FIRE  %s  (%d args)", timeStamp(), getPath(remote), argumentCount), COLORS.green)
            setStatus("Remote fired.", COLORS.green)
        else
            appendOutput("Fire error: " .. tostring(err), COLORS.red)
            setStatus("Remote failed.", COLORS.red)
        end
    end
end

