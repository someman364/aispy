    if valid then
        remoteClassLabel.Text = remoteKind(selectedRemote)
        remotePathLabel.Text = getPath(selectedRemote)
        fireButton.Text = if selectedRemote:IsA("RemoteFunction") then "INVOKE SERVER" else "FIRE SERVER"
        fireButton.BackgroundColor3 = if selectedRemote:IsA("RemoteFunction") then COLORS.orange else COLORS.accent
        fireButton.TextColor3 = if selectedRemote:IsA("RemoteFunction") then COLORS.background else Color3.fromRGB(255, 255, 255)
