local function readScriptSource(script)
    if sourceCache[script] then
        return sourceCache[script], "cache"
    end

    if API.decompile then
        local ok, result = pcall(API.decompile, script)
        if ok and type(result) == "string" and #result > 0 then
            sourceCache[script] = result
            return result, "decompile"
        end
    end

    local ok, source = pcall(function()
        return script.Source
    end)

    if ok and type(source) == "string" and #source > 0 then
        sourceCache[script] = source
        return source, "source"
    end

    if API.getScriptBytecode then
        local bytecodeOk, bytecode = pcall(API.getScriptBytecode, script)
        if bytecodeOk and type(bytecode) == "string" then
            return nil, string.format("No decompile() API found. Retrieved %d bytes of bytecode instead.", #bytecode)
        end
    end

    return nil, "Could not read this script. Your executor needs decompile() support."
end

