local API = {
    getScripts = type(getscripts) == "function" and getscripts or nil,
    getLoadedModules = type(getloadedmodules) == "function" and getloadedmodules or nil,
    getNilInstances = type(getnilinstances) == "function" and getnilinstances or nil,
    decompile = type(decompile) == "function" and decompile or nil,
    getScriptBytecode = type(getscriptbytecode) == "function" and getscriptbytecode or nil,
    hookMetamethod = type(hookmetamethod) == "function" and hookmetamethod or nil,
    getNamecallMethod = type(getnamecallmethod) == "function" and getnamecallmethod or nil,
    loadstring = type(loadstring) == "function" and loadstring or nil,
}

local function makeCClosure(callback)
    if type(newcclosure) == "function" then
        local ok, wrapped = pcall(newcclosure, callback)
        if ok and wrapped then
            return wrapped
        end
    end

    return callback
end

local function copyText(text)
    if type(setclipboard) == "function" then
        local ok = pcall(setclipboard, text)
        return ok
    end

    if type(toclipboard) == "function" then
        local ok = pcall(toclipboard, text)
        return ok
    end

    return false
end

