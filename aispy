connect(game.DescendantAdded, function(instance)
    if not isRemote(instance) then
        return
    end

    if isRemoteEvent(instance) then
        watchIncoming(instance)
    end

    if activeTab == "remotes" and not remoteRefreshQueued then
        remoteRefreshQueued = true

        task.delay(1, function()
            remoteRefreshQueued = false

            if screenGui.Parent and activeTab == "remotes" then
                refreshRemotes()
            end
        end)
    end
end)

connect(game.DescendantRemoving, function(instance)
    local connection = spyState.watched[instance]
    if connection then
        connection:Disconnect()
        spyState.watched[instance] = nil
    end
end)

-- Make the header draggable.
local dragArea = create("TextButton", {
    AutoButtonColor = false,
    BackgroundTransparency = 1,
    Size = UDim2.fromScale(1, 1),
    Text = "",
    ZIndex = 10,
}, header)

dragArea.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch
    then
        return
    end

    local startInputPosition = input.Position
    local startFramePosition = main.Position
    local moveConnection
    local endConnection

    moveConnection = UserInputService.InputChanged:Connect(function(changed)
        if changed.UserInputType ~= Enum.UserInputType.MouseMovement
            and changed.UserInputType ~= Enum.UserInputType.Touch
        then
            return
        end

        if input.UserInputType == Enum.UserInputType.Touch and changed ~= input then
            return
        end

        local delta = changed.Position - startInputPosition
        main.Position = UDim2.new(
            startFramePosition.X.Scale,
            startFramePosition.X.Offset + delta.X,
            startFramePosition.Y.Scale,
            startFramePosition.Y.Offset + delta.Y
        )
    end)

    endConnection = UserInputService.InputEnded:Connect(function(ended)
        if ended ~= input then
            return
        end

        if moveConnection then
            moveConnection:Disconnect()
        end
        if endConnection then
            endConnection:Disconnect()
        end
    end)
end)

