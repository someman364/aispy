    }, row)

    entry.row = row
    table.insert(spyEntries, 1, entry)
    spyEmptyLabel.Visible = false
    spyCountLabel.Text = string.format("%d EVENTS", spyCounter)

    row.MouseEnter:Connect(function()
        row.BackgroundColor3 = COLORS.panelHover
    end)

    row.MouseLeave:Connect(function()
