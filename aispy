cleanup = function()
    spyState.enabled = false

    for _, connection in pairs(spyState.watched) do
        connection:Disconnect()
    end
    table.clear(spyState.watched)

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)

    if screenGui then
        screenGui:Destroy()
    end

    if _G.RabakExplorerCleanup == cleanup then
        _G.RabakExplorerCleanup = nil
    end
end

_G.RabakExplorerCleanup = cleanup
closeButton.MouseButton1Click:Connect(cleanup)

