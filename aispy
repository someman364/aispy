local function parsePrimitive(token)
    token = trim(token)

    if token == "nil" then
        return nil
    end
    if token == "true" then
        return true
    end
    if token == "false" then
        return false
    end

    local number = tonumber(token)
    if number then
        return number
    end

    local quoted = token:match('^"(.*)"$') or token:match("^'(.*)'$")
    if quoted then
        return quoted
    end

    return nil, "Unsupported value: " .. token
end

local function parseArguments(source)
    source = trim(source)
    if source == "" then
        return { n = 0 }
    end

    if API.loadstring then
        local loadOk, chunk, compileError = pcall(API.loadstring, "return " .. source)
        if not loadOk then
            return nil, tostring(chunk)
        end
        if not chunk then
            return nil, compileError
        end

        local results = table.pack(pcall(chunk))
        if not results[1] then
            return nil, tostring(results[2])
        end

        local arguments = { n = results.n - 1 }
        for index = 2, results.n do
            arguments[index - 1] = results[index]
        end

        return arguments
    end

    local arguments = { n = 0 }
    for token in string.gmatch(source .. ",", "([^,]*),") do
        if trim(token) ~= "" then
            local value, parseError = parsePrimitive(token)
            if parseError then
                return nil, parseError
            end

            arguments.n += 1
            arguments[arguments.n] = value
        end
    end

    return arguments
end

local remoteOutput = ""

local function appendOutput(text, color)
    remoteOutput = remoteOutput == "" and text or (remoteOutput .. "\n" .. text)
    if #remoteOutput > 20000 then
        remoteOutput = remoteOutput:sub(-20000)
    end

    outputLabel.Text = remoteOutput
    outputLabel.TextColor3 = color or COLORS.muted

    task.defer(function()
        if outputScroll.Parent then
            outputScroll.CanvasPosition = Vector2.new(0, outputScroll.AbsoluteCanvasSize.Y)
        end
    end)
end

