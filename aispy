    for _, entry in ipairs(spyEntries) do
        if entry.row then
            entry.row:Destroy()
        end
    end

    table.clear(spyEntries)
    spyCounter = 0
    spyCountLabel.Text = "0 EVENTS"
    spyEmptyLabel.Visible = true
end

watchIncoming = function(remote)
    if not isRemoteEvent(remote) or spyState.watched[remote] then
        return
    end

    local connection = remote.OnClientEvent:Connect(function(...)
        if not spyState.enabled then
            return
        end

        pcall(spyLog, "IN", remote, "OnClientEvent", table.pack(...))
    end)

    spyState.watched[remote] = connection
end

local oldNamecall = nil

local function installSpyHook()
    if spyState.hooked then
        return true
    end

    if not API.hookMetamethod or not API.getNamecallMethod then
        return false, "hookmetamethod() is not available"
    end

    local function newNamecall(self, ...)
        local method = API.getNamecallMethod()

        if spyState.enabled
            and (method == "FireServer" or method == "InvokeServer")
            and typeof(self) == "Instance"
            and isRemote(self)
        then
            pcall(spyLog, "OUT", self, method, table.pack(...))
        end

        return oldNamecall(self, ...)
    end

    local ok, result = pcall(API.hookMetamethod, game, "__namecall", makeCClosure(newNamecall))
    if not ok or type(result) ~= "function" then
        return false, tostring(result)
    end

    oldNamecall = result
    spyState.hooked = true
    return true
end

